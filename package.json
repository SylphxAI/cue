{
  "name": "@sylphx/cue",
  "version": "0.3.5",
  "mcpName": "io.github.SylphxAI/cue",
  "description": "Cue — video answers with timestamp-level proof. The default read returns container metadata, streams, chapters, and embedded subtitles. Scenes and frames are separate.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "cue": "./bin/cue"
  },
  "files": [
    "bin/cue",
    "dist/",
    "README.md",
    "LICENSE",
    "src/"
  ],
  "exports": {
    ".": "./dist/doctor-cli.js",
    "./sdk": "./src/sdk.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/cue.git"
  },
  "homepage": "https://sylphxai.github.io/cue/",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "video-analysis",
    "video-search",
    "subtitles",
    "chapters",
    "scenes",
    "frames",
    "timestamps",
    "ffmpeg",
    "ffprobe",
    "timeline",
    "local-first",
    "rust",
    "ai-agents",
    "developer-tools",
    "cue",
    "sylphx"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build:rust": "CUE_PRODUCT_VERSION=$(node -p \"require('./package.json').version\") cargo build --release -p video-reader-core -p video-reader-cli -p video-reader-mcp-server && bun scripts/stage-rust-mcp.ts",
    "test:rust": "cargo test",
    "build": "bun build src/doctor-cli.ts --outdir dist --target node && chmod +x dist/doctor-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:rust-timeline": "cargo test && bun test test/rustTimeline.boundary.test.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "sync:server-json": "bun scripts/sync-server-json.ts",
    "version-packages": "changeset version && bun run sync:server-json && bun install",
    "start": "./bin/cue",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "bun run clean && bun run build && bun run build:rust",
    "release": "bun run typecheck && bun run check && bun run build && bun test && changeset publish",
    "doctor": "bun run src/doctor-cli.ts",
    "benchmark:release-gate": "bun scripts/release-gate.ts",
    "benchmark:public-proof": "bun scripts/public-proof.ts",
    "brand:pack-plan": "bun scripts/brand-pack-plan.ts",
    "compose:iris": "bun scripts/compose-iris.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.0",
    "@types/bun": "^1.2.19",
    "@types/node": "^25.9.1",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4"
  },
  "packageManager": "bun@1.4.2",
  "private": false,
  "optionalDependencies": {
    "@sylphx/cue-darwin-arm64": "0.3.5",
    "@sylphx/cue-darwin-x64": "0.3.5",
    "@sylphx/cue-linux-x64-gnu": "0.3.5",
    "@sylphx/cue-linux-arm64-gnu": "0.3.5"
  }
}
